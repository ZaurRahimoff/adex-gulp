extends ../layouts/default

block variables
	- var pageTitle = 'ADEX - Photo Gallery Details'
	- var pageDescription = 'Photo Gallery Details of ADEX Azerbaijan International Defence Exhibition'
	- var pageKeywords = 'ADEX, photo gallery details, exhibition photos, Azerbaijan'
	- var pageCanonical = 'https://adex.az/photo-gallery-details.html'
	- var pageOgImage = 'https://adex.az/og-image.jpg'
	- var pageAuthor = 'ADEX'

block content
	// Breadcrumb
	include ../mixins/_breadcrumb
	+breadcrumb([
		{text: 'Главная', href: 'index.html'},
		{text: 'Фотогалерея', href: 'photo-gallery.html'},
		{text: 'Press Conference 2024', href: null}
	])

	// Photo Gallery Details Section
	section.gallery-details
		.container
			// Page Title
			h1.page-title Press Conference 2024

			// Gallery Grid
			.row.g-4
				// Card 1
				.col-12.col-sm-6.col-lg-4.col-xl-3
					a.card.h-100.gallery-card.text-decoration-none(href="assets/img/webp/news1.webp" data-fancybox="gallery" data-caption="Press Conference 2024 - Photo 1")
						.card-img-top.gallery-card__img-wrapper
							i.fal.fa-magnifying-glass-plus
							img.card-img.gallery-card__img(src="assets/img/webp/news1.webp" alt="Press Conference 2024 - Photo 1" loading="lazy")

				// Card 2
				.col-12.col-sm-6.col-lg-4.col-xl-3
