extends ../layouts/default

block variables
	- var pageTitle = 'ADEX - Photo Gallery'
	- var pageDescription = 'Photo Gallery of ADEX Azerbaijan International Defence Exhibition'
	- var pageKeywords = 'ADEX, photo gallery, exhibition photos, Azerbaijan'
	- var pageCanonical = 'https://adex.az/photo-gallery.html'
	- var pageOgImage = 'https://adex.az/og-image.jpg'
	- var pageAuthor = 'ADEX'

block content
	// Breadcrumb
	include ../mixins/_breadcrumb
	+breadcrumb([
		{text: 'Главная', href: 'index.html'},
		{text: 'Фотогалерея', href: null}
	])

	// Photo Gallery Section
	section.gallery-section
		.container
			// Title Section with Year Selector
			.row.mb-5.g-4
				.col-12.col-md-6
					h1.page-title.lh-base.mb-2.mb-md-4 Photo Gallery
				.col-12.col-md-6.text-start.text-lg-end
					.mb-4.mb-lg-0.d-inline-block
						include ../mixins/_nice-select
						+nice-select('year', '2024', [
						{value: '2024', text: '2024'},
						{value: '2025', text: '2025'},
						{value: '2026', text: '2026'},
						{value: '2027', text: '2027'}
						], '', false, 'form-group--custom', 'nice-select--year', 'year-select')

			// Gallery Grid
			.row.g-4
				// Card 1
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="photo-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news1.webp" alt="Press Conference 2024" loading="lazy")
						.card-body
							h5.card-title Press Conference 2024

				// Card 2
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="photo-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news2.webp" alt="The visit of the President" loading="lazy")
						.card-body
							h5.card-title The visit of the President

				// Card 3
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="photo-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news3.webp" alt="Opening ceremony" loading="lazy")
						.card-body
							h5.card-title Opening ceremony

				// Card 4
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="photo-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news4.webp" alt="1st day of the exhibition" loading="lazy")
						.card-body
							h5.card-title 1st day of the exhibition

				// Card 5
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="photo-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news1.webp" alt="2nd day of the exhibition" loading="lazy")
						.card-body
							h5.card-title 2nd day of the exhibition

				// Card 6
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="photo-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news2.webp" alt="3rd day of the exhibition" loading="lazy")
						.card-body
							h5.card-title 3rd day of the exhibition

				// Pagination
				include ../mixins/_pagination
				+pagination({
					currentPage: 1,
					totalPages: 10,
					prevText: 'After',
					nextText: 'Before',
					showDivider: false
				})
