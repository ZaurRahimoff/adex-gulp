extends ../layouts/default

block variables
	- var pageTitle = 'ADEX - Contacts'
	- var pageDescription = 'Contact information for ADEX exhibition organisers and partners'
	- var pageKeywords = 'ADEX, contacts, organisers, partners, exhibition'
	- var pageCanonical = 'https://adex.az/contact.html'
	- var pageOgImage = 'https://adex.az/og-image.jpg'
	- var pageAuthor = 'ADEX'

block content
	// Breadcrumb
	include ../mixins/_breadcrumb
	+breadcrumb([
		{text: 'Главная', href: 'index.html'},
		{text: 'Kонтакты', href: null}
	])

	// Contact Section
	section.contact-page.page__spacing
		.container
			// Organisers Section
			.contact__section
				h1.contact__title Organisers
				.contact__wrapper
					.card.contact__card
						.row.g-0
							.col-12.col-lg-3.contact__logo-col
								.contact__logo
									img(src="https://ceo.az/projects/ceo/assets/logolight.webp?v=96.2.11" alt="Organiser Logo" loading="lazy")
							.col-12.col-lg-9.contact__info-col
								.contact__info
									h2.contact__company Iteca Caspian LLC
									.contact__person
										h3.contact__name Parvana Ahmadova
										p.contact__position Exhibition Manager
									.contact__contacts
										.row.row-cols-1.row-cols-lg-2.gx-0.gy-2.w-auto
											.col.contact__contact-col
												a.contact__contact-item(href="tel:+994124041001")
													i.fal.fa-phone.contact__contact-icon
													span.contact__contact-text +994 12 404 10 01 (office)
											.col.contact__contact-col
												a.contact__contact-item(href="tel:+994124041002")
													i.fal.fa-fax.contact__contact-icon
													span.contact__contact-text +994 12 404 10 02
											.col.contact__contact-col
												a.contact__contact-item(href="mailto:info@iteca.az")
													i.fal.fa-envelope.contact__contact-icon
													span.contact__contact-text info@iteca.az

					.card.contact__card
						.row.g-0
							.col-12.col-lg-3.contact__logo-col
								.contact__logo
									img(src="assets/img/webp/organiser-logo-2.webp" alt="Organiser Logo" loading="lazy")
							.col-12.col-lg-9.contact__info-col
								.contact__info
									h2.contact__company Iteca Caspian LLC
									.contact__person
										h3.contact__name Parvana Ahmadova
										p.contact__position Exhibition Manager
									.contact__contacts
										.row.row-cols-1.row-cols-lg-2.gx-0.gy-2.w-auto
											.col.contact__contact-col
												a.contact__contact-item(href="tel:+994124041001")
													i.fal.fa-phone.contact__contact-icon
													span.contact__contact-text +994 12 404 10 01
											.col.contact__contact-col
												a.contact__contact-item(href="tel:+994124041002")
													i.fal.fa-fax.contact__contact-icon
													span.contact__contact-text +994 12 404 10 02
											.col.contact__contact-col
												a.contact__contact-item(href="mailto:info@iteca.az")
													i.fal.fa-envelope.contact__contact-icon
													span.contact__contact-text info@iteca.az

			// Partners Section
			.contact__section
				h2.contact__title Partners
				.contact__wrapper
					.card.contact__card
						.row.g-0
							.col-12.col-lg-3.contact__logo-col
