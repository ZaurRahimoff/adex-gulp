extends ../layouts/default

block variables
	- var pageTitle = 'ADEX - Video Gallery'
	- var pageDescription = 'Video Gallery of ADEX Azerbaijan International Defence Exhibition'
	- var pageKeywords = 'ADEX, video gallery, exhibition videos, Azerbaijan'
	- var pageCanonical = 'https://adex.az/video-gallery.html'
	- var pageOgImage = 'https://adex.az/og-image.jpg'
	- var pageAuthor = 'ADEX'

block content
	// Breadcrumb
	include ../mixins/_breadcrumb
	+breadcrumb([
		{text: 'Главная', href: 'index.html'},
		{text: 'Видеогалерея', href: null}
	])

	// Video Gallery Section
	section.gallery-section
		.container
			// Header with title and year selector
			.gallery-header
				h1.page-title Video Gallery

				// Year selector
				.year-selector
					select.form-select.year-selector__select(aria-label="Select year")
						option(selected) 2026
						option 2025
						option 2024
						option 2023

			// Gallery Grid
			.row.g-4
				// Card 1
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="video-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news1.webp" alt="Press Conference 2024" loading="lazy")
						.card-body
							h5.card-title Press Conference 2024

				// Card 2
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="video-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news2.webp" alt="The visit of the President" loading="lazy")
						.card-body
							h5.card-title The visit of the President

				// Card 3
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="video-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news3.webp" alt="Opening ceremony" loading="lazy")
						.card-body
							h5.card-title Opening ceremony

				// Card 4
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="video-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news1.webp" alt="1st day of the exhibition" loading="lazy")
						.card-body
							h5.card-title 1st day of the exhibition

				// Card 5
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="video-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news1.webp" alt="2nd day of the exhibition" loading="lazy")
						.card-body
							h5.card-title 2nd day of the exhibition

				// Card 6
				.col-12.col-lg-4
					a.card.h-100.gallery-card.text-decoration-none(href="video-gallery-details.html")
						.card-img-top.gallery-card__img-wrapper
							img.card-img.gallery-card__img(src="assets/img/webp/news2.webp" alt="3rd day of the exhibition" loading="lazy")
						.card-body
							h5.card-title 3rd day of the exhibition

				.col-12.col-lg-12
					// Pagination
					include ../mixins/_pagination
					+pagination({
						currentPage: 1,
						totalPages: 10,
						prevText: 'After',
						nextText: 'Before',
						showDivider: false
					})
