extends ../layouts/default

block variables
	- var pageTitle = 'ADEX - About Company'
	- var pageDescription = 'Caspian Event Organisers - leading position in organising exhibitions and conferences in Azerbaijan'
	- var pageKeywords = 'ADEX, Caspian Event Organisers, CEO, exhibitions, conferences, Azerbaijan'
	- var pageCanonical = 'https://adex.az/about-company.html'
	- var pageOgImage = 'https://adex.az/og-image.jpg'
	- var pageAuthor = 'ADEX'

block content
	// Breadcrumb
	include ../mixins/_breadcrumb
	+breadcrumb([
		{text: 'Главная', href: 'index.html'},
		{text: 'О компании', href: null}
	])

	// About Company Section
	include ../mixins/_yt-video
	section.about-company-section
		.container
			// Title Section
			.row.mb-5.g-4
				.col-12.col-md-6
					h1.page-title.lh-base.mb-2.mb-md-4 Company

				.col-12
					// Video Block
					.about-company-section__video
						+yt-video('wfsTGsXGKvE', null, { buttonStyle: 'primary' })

					// Content Block (Logo + Text)
					.about-company-section__content
						// Logo
						.about-company-section__logo
							img(src="assets/img/ceo-logo.svg" alt="Caspian Event Organisers Logo" loading="lazy")

						// Text
						.about-company-section__text
							p Caspian Event Organisers (CEO) holds a leading position in organising exhibitions and conferences in Azerbaijan. Since its establishment in 2014, it has become a key player in the congress and exhibition industry, actively developing both national and international brands such as ADEX, Caspian Agro, Rebuild Karabakh, TransLogistica Caspian, Medinex, and others. Today, the company's portfolio includes more than 10 specialised annual events. The President of the Republic of Azerbaijan, Mr. Ilham Aliyev, has consistently shown support for these exhibitions over the years, visiting the events and meeting with participants. The exhibitions are supported by relevant government agencies. The company upholds high standards of organisation and professionalism, as evidenced by the support of international organisations such as UFI (The Global Association of the Exhibition Industry) and ICCA (International Congress and Convention Association). Caspian Event Organisers is also a member of the Azerbaijan Exhibition Organisers Association (ASTA), further solidifying its status as a reliable partner in the field of exhibitions and conferences. Exhibitions organised by Caspian Event Organisers help strengthen business connections, facilitate technology exchange, and promote economic growth in the region. They provide platforms for interaction between representatives of various industries and contribute to enhancing international cooperation.

					// Contact Card
					.about-company-section__contact
						h2.about-company-section__contact-title Contact

						.about-company-section__contact-info
							.row.g-3
								// Phones Column
								.col-12.col-lg-auto
									.about-company-section__contact-group
										.about-company-section__contact-item
											i.about-company-section__contact-icon.far.fa-phone
											a(href="tel:+994124041000") +994 12 404 10 00
										.about-company-section__contact-item
											i.about-company-section__contact-icon.far.fa-phone
											a(href="tel:+994552241000") +994 55 224 1000

								// Address and Email Column
								.col-12.col-lg
									.about-company-section__contact-group
										.about-company-section__contact-item.about-company-section__contact-item--address
											i.about-company-section__contact-icon.far.fa-location-dot
											a(href="https://maps.app.goo.gl/E9zUY1jZgXaVt2JZ7" target="_blank") Azerbaijan, Baku Narimanov dist., Zaur Nudiraliyev st., 61, AZ1075
										.about-company-section__contact-item
											i.about-company-section__contact-icon.far.fa-envelope
											a(href="mailto:office@ceo.az") office@ceo.az

					// Divider
					.about-company-section__divider
