extends ../layouts/default

block variables
  - var pageTitle = 'ADEX - Преимущества участия'
  - var pageDescription = 'ADEX - Преимущества участия в международной военной выставке'
  - var pageKeywords = 'ADEX, преимущества, участие, выставка, военная выставка'
  - var pageCanonical = 'https://adex.az/why-exhibit'
  - var pageOgImage = 'https://adex.az/og-image.jpg'
  - var pageAuthor = 'ADEX'

block content
  // Breadcrumb Section
  include ../mixins/_breadcrumb
  +breadcrumb([
    {text: 'Главная', href: 'index.html'},
    {text: 'Преимущества участия', href: null}
  ])

  // Main Content
  section.why-exhibit.page__spacing
    .container
      // Title Section
      .row.mb-5.g-4
        .col-12.col-md-6
          h1.page-title.lh-base.mb-2.mb-md-4 Benefits of Participation at Adex
      
      // Page Content
      .row
        .col-12

          .page-content
            h2 1. Bilateral meetings with international military delegations
            p By official invitation of the Ministry of Defence Industry and the Ministry of Defence of the Republic of Azerbaijan, the exhibition is visited by more than 150 high-ranking representatives from over 30 international military delegations, with whom exhibition participants have an opportunity to meet
            img(src="assets/img/why-exhibit/benefit-1.jpg" alt="Bilateral meetings with international military delegations" loading="lazy")

            h2 2. Exclusive networking opportunities
            p B2B meetings are held to form part of the exhibition; at the request of exhibitors, various organisations and potential partners are invited to participate in these meetings. On the first day of the exhibition, an official evening reception is held for exhibitors, the country's military leadership and international military delegations.
            img(src="assets/img/why-exhibit/benefit-2.jpg" alt="Exclusive networking opportunities" loading="lazy")

            h2 3. Meetings with top tier local military authorities
            p The Minister of Defence, Deputy Minister, leadership of the navy, aviation and army, as well as the leadership of the Ministry of Emergency Situations, Border Service, the Ministry of Internal Affairs, Interior Ministry troops and other security agencies of the Azerbaijan Republic visit the exhibition for bilateral meetings.
            img(src="assets/img/why-exhibit/benefit-3.jpg" alt="Meetings with top tier local military authorities" loading="lazy")

            h2 4. National stands
            p About ten national stands take part in the ADEX exhibition representing the defence industry of their countries. Russia, Ukraine, Turkey, Israel, Serbia, Pakistan, Belarus and China are amongst the permanent participating countries.
            img(src="assets/img/why-exhibit/benefit-4.jpg" alt="National stands" loading="lazy")

            h2 5. Organisation and support by the Ministry of Defence Industry of the Republic of Azerbaijan
            p While acting as an organiser of the ADEX exhibition, the Ministry of Defence Industry of Azerbaijan plays an active role by highlighting the production capacity of its enterprises and promoting the development of cooperation with foreign manufacturers and technology transfer.
            img(src="assets/img/why-exhibit/benefit-5.jpg" alt="Organisation and support by the Ministry of Defence Industry" loading="lazy")
