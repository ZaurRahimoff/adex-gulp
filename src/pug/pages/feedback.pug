extends ../layouts/default

block variables
	- var pageTitle = 'ADEX - Feedback'
	- var pageDescription = 'Contact us with your feedback, questions or comments about ADEX exhibition'
	- var pageKeywords = 'ADEX, feedback, contact, questions, comments, exhibition'
	- var pageCanonical = 'https://adex.az/feedback.html'
	- var pageOgImage = 'https://adex.az/og-image.jpg'
	- var pageAuthor = 'ADEX'

block content
	// Breadcrumb
	include ../mixins/_breadcrumb
	+breadcrumb([
		{text: 'Главная', href: 'index.html'},
		{text: 'Обратная связь', href: null}
	])

	// Feedback Section
	section.feedback-section
		.container
			// Page Title
			h1.feedback-section__title Feedback

			// Feedback Form
			.feedback-form.form-container
				// Required Fields Note
				p.form-note
					| Fields marked with 
					span.form-note__asterisk *
					|  are required

				// Divider
				.form-divider

				// Form
				form.form-layout(action="#" method="POST")
					// Name, surname
					include ../mixins/_form-input
					+form-input('name', 'text', 'Name, surname', '', true, '', 'form-input-transparent')

					// E-mail
					+form-input('email', 'email', 'E-mail', '', true, '', 'form-input-transparent')

					// Mobile
					include ../mixins/_form-phone
					+form-phone('mobile', 'Mobile', true, '', 'form-phone-group', 'az')

					// Your comments/questions
					include ../mixins/_form-textarea
					+form-textarea('comments', 'Your comments/questions', '', true, 6, '', 'form-textarea-transparent')

					// Consent Checkbox
					include ../mixins/_form-checkbox
					+form-checkbox('consent', 'I give my consent to processing of my personal data', false, false)

					// Submit Button
					button.btn.form-submit(type="submit") Submit

		// Map
		.feedback-map.grayscale
			iframe(
				src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3039.0!2d49.85!3d40.4!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDDCsDI0JzAwLjAiTiA0OcKwNTEnMDAuMCJF!5e0!3m2!1sen!2saz!4v1234567890"
				width="100%"
				height="500"
				style="border:0;"
				allowfullscreen=""
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				title="ADEX Location Map"
			)

		.container
			// Contact Card
			.feedback-contact-card
				h2.feedback-contact-card__title Contact
				.feedback-contact-card__info
					.row.g-3
						// Phones Column
						.col-12.col-lg-auto
							.feedback-contact-card__group
								.feedback-contact-card__item
									i.feedback-contact-card__icon.far.fa-phone
									a.feedback-contact-card__text(href="tel:+994124041000") +994 12 404 10 00
								.feedback-contact-card__item
									i.feedback-contact-card__icon.far.fa-phone
									a.feedback-contact-card__text(href="tel:+994552241000") +994 55 224 1000

						// Address and Email Column
						.col-12.col-lg
							.feedback-contact-card__group
								.feedback-contact-card__item.feedback-contact-card__item--address
									i.feedback-contact-card__icon.far.fa-location-dot
									a.feedback-contact-card__text(href="https://maps.app.goo.gl/E9zUY1jZgXaVt2JZ7" target="_blank") Azerbaijan, Baku Narimanov dist., Zaur Nudiraliyev st., 61, AZ1075
								.feedback-contact-card__item
									i.feedback-contact-card__icon.far.fa-envelope
									a.feedback-contact-card__text(href="mailto:office@ceo.az") office@ceo.az
