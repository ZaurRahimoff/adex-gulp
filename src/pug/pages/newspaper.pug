extends ../layouts/default

block variables
	- var pageTitle = 'ADEX - Daily Newspaper'
	- var pageDescription = 'Daily newspaper for ADEX exhibition'
	- var pageKeywords = 'ADEX, newspaper, daily newspaper, exhibition'
	- var pageCanonical = 'https://adex.az/newspaper.html'
	- var pageOgImage = 'https://adex.az/og-image.jpg'
	- var pageAuthor = 'ADEX'

block content
	// Breadcrumb
	include ../mixins/_breadcrumb
	+breadcrumb([
		{text: 'Главная', href: 'index.html'},
		{text: 'Газета выставки', href: null}
	])

	// Newspaper Section
	section.newspaper-page.page__spacing
		.container
			// Title Section with Year Selector
			.row.mb-5.g-4
				.col-12.col-md-6
					h1.page-title.lh-base.mb-2.mb-md-4 Daily Newspaper

				.col-12.col-md-6.text-start.text-lg-end
					.mb-4.mb-lg-0.d-inline-block
						include ../mixins/_nice-select
						+nice-select('year', '2024', [
						{value: '2024', text: '2024'},
						{value: '2025', text: '2025'},
						{value: '2026', text: '2026'},
						{value: '2027', text: '2027'}
						], '', false, 'form-group--custom', 'nice-select--year', 'year-select')

			// Newspaper Card Wrapper
			.newspaper__wrapper
				.container
					.row.row-cols-1.row-cols-md-2.row-cols-lg-4.g-4
						.col
							.card.newspaper__card.h-100
								.newspaper__image-wrapper
									img.newspaper__image.card-img-top(src="assets/img/webp/news1.webp" alt="Adex 2024 Newspaper" loading="lazy")
								.card-footer.newspaper__content
									span.newspaper__name Adex 2024
									button.newspaper__download(type="button" aria-label="Download newspaper")
										i.fas.fa-arrow-down-long-to-line
						.col
							.card.newspaper__card.h-100
								.newspaper__image-wrapper
									img.newspaper__image.card-img-top(src="assets/img/webp/news1.webp" alt="Adex 2024 Newspaper" loading="lazy")
								.card-footer.newspaper__content
									span.newspaper__name Adex fdsfsdfsdfsdf fsdfsdfdsfsd fsd 2024
									button.newspaper__download(type="button" aria-label="Download newspaper")
										i.fas.fa-arrow-down-long-to-line
						.col
							.card.newspaper__card.h-100
								.newspaper__image-wrapper
									img.newspaper__image.card-img-top(src="assets/img/webp/news1.webp" alt="Adex 2024 Newspaper" loading="lazy")
								.card-footer.newspaper__content
