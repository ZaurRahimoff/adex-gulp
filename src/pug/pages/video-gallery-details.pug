extends ../layouts/default

block variables
	- var pageTitle = 'ADEX - Video Gallery Details'
	- var pageDescription = 'Video Gallery Details of ADEX Azerbaijan International Defence Exhibition'
	- var pageKeywords = 'ADEX, video gallery details, exhibition videos, Azerbaijan'
	- var pageCanonical = 'https://adex.az/video-gallery-details.html'
	- var pageOgImage = 'https://adex.az/og-image.jpg'
	- var pageAuthor = 'ADEX'

block content
	// Breadcrumb
	include ../mixins/_breadcrumb
	+breadcrumb([
		{text: 'Главная', href: 'index.html'},
		{text: 'Видеогалерея', href: 'video-gallery.html'},
		{text: 'Press Conference 2024', href: null}
	])

	// Video Gallery Details Section
	section.gallery-details
		.container
			// Page Title
			h1.page-title Press Conference 2024

			// Gallery Grid
			.row.g-4
				// Card 1
				.col-12.col-sm-6.col-lg-4.col-xl-3
					a.card.h-100.gallery-card.gallery-card--video.text-decoration-none(href="https://www.youtube.com/watch?v=wfsTGsXGKvE" data-fancybox="video-gallery" data-caption="Press Conference 2024 - Video 1")
						.card-img-top.gallery-card__img-wrapper
							i.fal.fa-circle-play
							img.card-img.gallery-card__img(src="assets/img/webp/news1.webp" alt="Press Conference 2024 - Video 1" loading="lazy")

				// Card 2
				.col-12.col-sm-6.col-lg-4.col-xl-3
					a.card.h-100.gallery-card.gallery-card--video.text-decoration-none(href="https://www.youtube.com/watch?v=wfsTGsXGKvE" data-fancybox="video-gallery" data-caption="Press Conference 2024 - Video 2")
						.card-img-top.gallery-card__img-wrapper
							i.fal.fa-circle-play
							img.card-img.gallery-card__img(src="assets/img/photo-slide2.png" alt="Press Conference 2024 - Video 2" loading="lazy")

